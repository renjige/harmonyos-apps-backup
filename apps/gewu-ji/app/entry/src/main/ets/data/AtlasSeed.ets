    atlasKind: string, coverKey: string, summary: string, body: string,
    f1: string, c1: string, f2: string, c2: string, f3: string, c3: string
  ): KnowledgeObject {
    const obj = new KnowledgeObject()
    obj.id = id
    obj.title = title
    obj.category = category
    obj.atlasKind = atlasKind
    obj.coverKey = coverKey
    obj.summary = summary
    obj.body = body
    obj.addFact(f1, c1)
    obj.addFact(f2, c2)
    obj.addFact(f3, c3)
    obj.addTimeline('观察', '适合作为格物记录对象')
    obj.addTimeline('对照', '可与集册中同图鉴条目互参')
    return obj
