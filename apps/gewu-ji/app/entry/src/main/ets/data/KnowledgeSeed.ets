import { KnowledgeObject } from '../models/KnowledgeModels'

class SeedRow {
  id: string = ''
  title: string = ''
  category: '历史' | '科学' | '文化' | '哲学' | '艺术' = '历史'
  coverKey: string = ''
  summary: string = ''
  body: string = ''
  fact1Label: string = ''
  fact1Content: string = ''
  fact2Label: string = ''
  fact2Content: string = ''
  fact3Label: string = ''
  fact3Content: string = ''
  tl1Year: string = ''
  tl1Event: string = ''
  tl2Year: string = ''
  tl2Event: string = ''
  tl3Year: string = ''
  tl3Event: string = ''
}

export class KnowledgeSeed {
  static buildPool(): KnowledgeObject[] {
    const rows = KnowledgeSeed.allRows()
    const out: KnowledgeObject[] = []
    for (const row of rows) {
      const obj = new KnowledgeObject()
      obj.id = row.id
      obj.title = row.title
      obj.category = row.category
      obj.coverKey = row.coverKey
      obj.summary = row.summary
      obj.body = row.body
      obj.addFact(row.fact1Label, row.fact1Content)
      obj.addFact(row.fact2Label, row.fact2Content)
      if (row.fact3Label.length > 0) {
        obj.addFact(row.fact3Label, row.fact3Content)
      }
      obj.addTimeline(row.tl1Year, row.tl1Event)
      obj.addTimeline(row.tl2Year, row.tl2Event)
      if (row.tl3Year.length > 0) {
        obj.addTimeline(row.tl3Year, row.tl3Event)
      }
      out.push(obj)
    }
    return out
  }

  private static row(
    id: string, title: string, category: '历史' | '科学' | '文化' | '哲学' | '艺术', coverKey: string,
    summary: string, body: string,
    f1l: string, f1c: string, f2l: string, f2c: string, f3l: string, f3c: string,
    t1y: string, t1e: string, t2y: string, t2e: string, t3y: string, t3e: string
  ): SeedRow {
    const r = new SeedRow()
    r.id = id
    r.title = title
    r.category = category
    r.coverKey = coverKey
    r.summary = summary
    r.body = body
    r.fact1Label = f1l
    r.fact1Content = f1c
    r.fact2Label = f2l
    r.fact2Content = f2c
    r.fact3Label = f3l
    r.fact3Content = f3c
    r.tl1Year = t1y
    r.tl1Event = t1e
    r.tl2Year = t2y
    r.tl2Event = t2e
    r.tl3Year = t3y
    r.tl3Event = t3e
    return r
  }

