/**
 * 登录/设置页协议全文，与 store/privacy-policy.md、user-agreement.md 一致。
 * 应用名称、开发者、运营者与 AppGallery Connect 提交信息一致。
 */
import { BrandIdentity } from '../config/BrandIdentity'

export class LegalDocs {
  static privacyTitle(): string {
    return '隐私政策'
  }

  static agreementTitle(): string {
    return '用户协议'
  }

  static privacyBody(): string {
    return BrandIdentity.legalHeader() + '\n' +
      '一、信息收集\n' +
      '游客浏览公开旅行模板与出行贴士时不要求提供个人信息。注册时收集账号、姓名和手机号；登录后，您主动创建的旅行目的地、日期、每日安排、清单事项、提醒和备忘会保存至云端，用于跨会话展示与同步。\n\n' +
      '二、使用与存储\n' +
      '上述信息仅用于账号认证、旅行计划管理、清单准备、提醒与备忘服务。应用仅申请网络访问权限，用于连接出行备忘业务服务；不申请定位、相机、通讯录等权限。\n\n' +
      '三、共享与第三方\n' +
      '本应用不接入广告或用户画像服务，不向第三方出售个人信息。业务数据通过开发者管理的 HTTPS 服务处理。当前版本不提供生成式人工智能对话。\n\n' +
      '四、您的权利\n' +
      '您可在“我的 → 设置与隐私”查看协议、撤回隐私同意或注销账号。撤回后将退出登录，再次登录须重新勾选协议；注销将删除账号及其关联数据。\n\n' +
      `五、安全与联系\n我们采用租户隔离、传输加密和访问控制保护数据。如需查询、更正或反馈，请通过华为应用市场公示的开发者联系方式，或应用内「我的 → 关于」联系开发者${BrandIdentity.developer()}。`
  }

  static agreementBody(): string {
    return BrandIdentity.legalHeader() + '\n' +
      '一、服务内容\n' +
      `${BrandIdentity.appName()}面向个人与家庭，覆盖规划、准备、出发与记录完整出行场景：旅行计划与每日时间轴、准备中心（打包清单/出发提醒/旅途备忘）、出行攻略（模板与贴士）、行程倒计时与出行概览。游客可浏览公开模板与贴士；创建、修改或同步个人内容前需注册并登录。本应用不提供票务预订、支付或社交。\n\n` +
      '二、账号规则\n' +
      '您应提供真实、合法的注册信息并妥善保管账号密码，不得冒用他人身份或利用本应用发布违法内容。\n\n' +
      '三、使用说明\n' +
      '行程时间、地址与提醒均由用户录入或平台内容提供，请在出发前自行核对交通、住宿及目的地官方信息。本应用的提醒不替代航空、铁路、酒店等服务方通知，也不承担因设备断电、网络异常或系统限制导致提醒未触达的责任。模板与贴士仅供整理参考。\n\n' +
      '四、服务变更与退出\n' +
      '您可退出登录、撤回隐私同意或注销账号。路径：我的 → 设置与隐私。必要维护可能造成短暂不可用，我们会尽力恢复服务。\n\n' +
      `五、联系我们\n如对本协议或服务有疑问，请通过华为应用市场公示的开发者联系方式联系开发者${BrandIdentity.developer()}。`
  }
}
