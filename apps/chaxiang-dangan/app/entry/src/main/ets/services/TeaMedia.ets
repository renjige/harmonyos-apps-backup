export class TeaMedia {
  static hero(): Resource {
    return $r('app.media.hero_tea_space')
  }

  static empty(): Resource {
    return $r('app.media.empty_cup')
  }

  static cabinet(): Resource {
    return $r('app.media.cabinet_wood')
  }

  static tasting(): Resource {
    return $r('app.media.tasting_texture')
  }

  static review(): Resource {
    return $r('app.media.review_ambient')
  }
}
