export class PromptService {
  private static prompts(): string[] {
    return [
      '此刻窗边的光线落在哪里？',
      '最近一次让你停下来的细小声音是什么？',
      '桌上哪件物品的质感最想被写下来？',
      '今天空气里有没有一种说不清的气味？',
      '路边哪一块颜色比昨天更安静？',
      '你注意到谁的一个微表情？',
      '一杯水/茶的温度此刻如何？',
      '影子的形状像什么？',
      '远处有什么正在缓慢发生？',
      '你口袋里或包里哪件东西最有故事？',
      '一句话描述此刻的天气，不写温度。',
      '手指碰到的第一个表面是冷还是暖？',
      '如果只准记下一种气味，你会选哪一种？',
      '今天哪道光让你想伸手去挡或去接？',
      '房间里最容易被忽略的角落叫什么？',
      '写下一个没有名字的声音。',
      '植物或叶子现在是什么姿态？',
      '地面的纹路让你想起什么？',
      '一句极短的旁白，给正在发生的这一秒。',
      '把眼前三种颜色按远近排成一行。',
      '谁从你身边走过，留下了什么痕迹？',
      '纸页或屏幕反光里藏着什么？',
      '把「微小」写成一个具体的尺寸。',
      '今天哪件旧物被重新看见？',
      '记录一次呼吸前后的差别。',
      '窗外的层次：近、中、远各写一词。',
      '一个不值得拍照、但值得写下的瞬间。',
      '手边工具（笔、杯、钥匙）此刻的重量。',
      '把今天的一种情绪翻译成一种材质。',
      '如果明天醒来只记得一件小事，会是哪件？'
    ]
  }

  static todayPrompt(dateKey: string): string {
    const list = PromptService.prompts()
    let hash = 0
    for (let i = 0; i < dateKey.length; i++) {
      hash = (hash + dateKey.charCodeAt(i) * (i + 3)) % 997
    }
    const idx = hash % list.length
    return list[idx]
  }
}
