  static cardById(id: string): CardItem | undefined {
    for (const item of AtelierCatalog.cards()) {
      if (item.id === id) {
        return item
      }
    }
    return undefined
  }

  static dailyById(id: string): DailyItem | undefined {
    for (const item of AtelierCatalog.daily()) {
      if (item.id === id) {
        return item
      }
    }
    return undefined
  }
