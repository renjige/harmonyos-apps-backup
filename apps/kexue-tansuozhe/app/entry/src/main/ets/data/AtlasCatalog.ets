  static findById(id: string): AtlasItem | undefined {
    for (const item of AtlasCatalog.all()) {
      if (item.id === id) {
        return item
      }
    }
    return undefined
  }

  static byCategory(cat: string): AtlasItem[] {
    const out: AtlasItem[] = []
    for (const item of AtlasCatalog.all()) {
      if (item.category === cat) {
        out.push(item)
      }
    }
    return out
  }

  static search(keyword: string): AtlasItem[] {
    const key = keyword.trim().toLowerCase()
    if (key.length === 0) {
      return []
    }
    const out: AtlasItem[] = []
    for (const item of AtlasCatalog.all()) {
      let hit = false
      if (item.name.toLowerCase().includes(key)) { hit = true }
      if (item.summary.toLowerCase().includes(key)) { hit = true }
      if (item.funFact.toLowerCase().includes(key)) { hit = true }
      for (const kw of item.keywords) {
        if (kw.toLowerCase().includes(key)) { hit = true }
      }
      for (const tr of item.traits) {
        if (tr.toLowerCase().includes(key)) { hit = true }
      }
      if (hit) { out.push(item) }
    }
    return out
  }
}
