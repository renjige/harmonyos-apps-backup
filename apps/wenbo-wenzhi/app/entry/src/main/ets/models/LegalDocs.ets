/**
 * 登录/注册页可打开的协议全文（与 store/privacy-policy.md、user-agreement.md 对齐）。
 */
export class LegalDocs {
  static privacyTitle(): string {
    return '隐私政策'
  }

  static agreementTitle(): string {
    return '用户协议'
  }

  static privacyBody(): string {
    return '隐私政策\n\n运营者：魏文波\n应用名称：问知\n\n' +
      '一、我们如何收集和使用信息\n' +
      '1. 游客可浏览分类知识、检索、每日新知与知识挑战，无需提供账号。\n' +
      '2. 若你注册/登录，我们将收集账号、密码、姓名、电话，用于账号识别与登录态保持。\n' +
      '3. 你主动收藏、备注、知识卡片、提问记录、错题与学习进度默认保存在本机；登录后可选择同步收藏到云端。\n' +
      '4. 问答次数、阅读条数、答题次数、连续学习天数保存在本机，用于学习统计。\n' +
      '5. 求知偏好问卷答案仅用于生成模板报告，默认不上传。\n\n' +
      '二、权限\n' +
      '本应用申请网络权限（ohos.permission.INTERNET），用于在使用时拉取解答库、每日新知、消息，以及可选的登录同步。不申请相机、定位、麦克风、通讯录。\n\n' +
      '三、第三方共享\n' +
      '本版本不向大模型服务传输你的提问或对话。业务数据经运营者使用的云端接口（saas16.qianqi.online）按租户隔离存储。\n\n' +
      '四、你的权利\n' +
      '可在「我的 → 设置与隐私」查看本政策与《用户协议》，撤回隐私同意，注销账号。撤回后再次登录须重新勾选协议。\n\n' +
      '五、联系方式\n' +
      '请通过华为开发者联盟预留渠道或应用内反馈联系运营者魏文波。\n\n' +
      '本政策自你勾选同意之日起适用。'
  }

  static agreementBody(): string {
    return '用户协议\n\n运营者：魏文波\n应用名称：问知\n\n' +
      '一、服务说明\n' +
      '问知提供分类知识查询、关键词检索、结构化解答、个人知识库（收藏/标签/笔记）、提问记录、每日新知答题、知识挑战与错题再练、学习计划与打卡、学习动态时间轴、成就墙、本周回顾与成长统计。游客可浏览与本机记录；登录后可注册账号并可选同步收藏。\n\n' +
      '二、使用规范\n' +
      '解答仅供学习参考，不构成医疗、法律、投资或其他专业意见。请勿将本应用用于违法用途。\n\n' +
